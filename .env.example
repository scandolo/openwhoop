# All optional. Defaults are fine for running on your own computer.
# HOST=127.0.0.1            # 0.0.0.0 to listen on the network (then a password is required)
# PORT=8787
# OPENWHOOP_DATA_DIR=data
# OPENWHOOP_PASSWORD=        # set the owner password from the environment
# OPENWHOOP_AUTH=auto        # auto | on (password even on localhost) | off (never; trusted networks only)
# PUBLIC_URL=https://whoop.example.com   # for OAuth callbacks behind a proxy
# RAW_RETENTION_DAYS=30      # how long to keep raw strap frames for re-decoding (0 = forever)
